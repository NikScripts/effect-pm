# EAS archives from the git root, which for this app is the whole Hyperlink
# monorepo — docs, examples, and every other package, none of which the
# native build needs. Without this the upload is the entire repo.
#
# The workspace manifests and lockfile at the root are deliberately NOT
# ignored: pnpm needs them to install packages/agent-console-native's
# dependencies from the workspace root.

# Other packages in the workspace
/packages/*
!/packages/agent-console-native/

# Docs, examples, and site content
/docs/
/examples/
/dev/

# Build/test artifacts
**/node_modules/
**/.expo/
**/dist/
**/build/
**/coverage/
**/*.tsbuildinfo
