    "./storage/redis": {
      "types": "./dist/storage/redis.d.ts",
      "default": "./dist/storage/redis.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.src.strict-effect-provide.json",
    "test": "vitest run",
    "treeshake": "node scripts/treeshake-check.mjs",
    "test:nwsl": "node scripts/nwsl-local.mjs test",
    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern repos/**",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "example:queue-widget": "vite --config examples/queue-widget/vite.config.ts",
    "example:queue-server": "tsx examples/web-dashboard/queue-server.ts",
    "example:mini-server": "tsx examples/web-dashboard/mini-server.ts",
    "example:web-dashboard": "vite --config examples/web-dashboard/vite.config.ts examples/web-dashboard",
    "example:resource-web": "vite --config examples/resource-web/vite.config.ts examples/resource-web",
    "example:resource-web-server": "tsx examples/resource-web/server.ts",
    "example:resource-cli": "tsx examples/resource-cli/counter-cli.ts",
    "example:resource-cli-manager": "tsx examples/resource-cli/manager-cli.ts",
    "example:resource-tui": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/counter-tui.tsx",
    "example:resource-tui-grid": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/grid-tui.tsx",
    "example:resource-tui-manager": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/manager-tui.tsx",
    "example:pm": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/pm.tsx",
    "example:group-terminal": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/group-terminal.tsx",
    "example:queue-mock": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/queue-mock.tsx",
    "example:group-grid": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/group-grid-mock.tsx",
    "example:queue-logs": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/queue-logs-mock.tsx",
    "example:dashboard": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/dashboard.tsx",
    "example:session": "bash scripts/effect-example.sh",
    "example:dashboard-mock": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/dashboard-mock.tsx",
    "example:queue-live": "tsx --tsconfig examples/resource-tui/tsconfig.json examples/resource-tui/queue-live.tsx",
    "example:queue-resource": "tsx examples/forms/queue/queue-resource-priority-retry.ts",
    "example:custom-queue-resource": "tsx examples/forms/queue/custom-queue-resource-n-level.ts",
    "example:process-patterns": "tsx examples/forms/polling/polling-accelerating.ts && tsx examples/forms/polling/schedule-delayed-start.ts",
    "example:process-supervisor-patterns": "tsx examples/forms/polling/polling-accelerating.ts && tsx examples/forms/polling/schedule-delayed-start.ts",
    "example:sports-polling-accelerating": "tsx examples/forms/polling/polling-spaced-read.ts && tsx examples/forms/polling/polling-accelerating-reset-cadence.ts && tsx examples/forms/polling/polling-accelerating-peek-cadence.ts",
    "example:schedule-gates-and-cron": "pnpm run example:schedule-control-surfaces",
    "example:schedule-control-surfaces": "tsx examples/forms/schedule/schedule-controls-initializer.ts && tsx examples/forms/schedule/schedule-controls-in-effect.ts && tsx examples/forms/schedule/schedule-controls-external-fiber.ts",
    "example:schedule-control-basics": "tsx examples/forms/schedule/schedule-at.ts && tsx examples/forms/schedule/schedule-window.ts && tsx examples/forms/schedule/schedule-define.ts",
    "example:schedule-control-db-sync": "tsx examples/scenarios/schedule-sync-from-external-db.ts",
    "example:run-resource": "tsx examples/forms/resource/run-resource-unit-and-input.ts",
    "example:run-resource-store-readback": "tsx examples/forms/resource/run-resource-store-readback.ts",
    "example:http-client-run-gate": "tsx examples/forms/resource/http-client-run-gate.ts",
    "example:http-api-resource": "tsx examples/forms/resource/http-api-resource-tag-layer.ts",
    "example:nwsl-http-api-resource": "node scripts/nwsl-local.mjs example",
    "example:http-api-resource-layer-effect": "tsx examples/forms/resource/http-api-resource-layer-effect.ts",
    "example:form:schedule-at": "tsx examples/forms/schedule/schedule-at.ts",
    "example:form:schedule-window": "tsx examples/forms/schedule/schedule-window.ts",
    "example:form:schedule-define": "tsx examples/forms/schedule/schedule-define.ts",
    "example:form:schedule-controls-initializer": "tsx examples/forms/schedule/schedule-controls-initializer.ts",
    "example:form:schedule-controls-in-effect": "tsx examples/forms/schedule/schedule-controls-in-effect.ts",
    "example:form:schedule-controls-external-fiber": "tsx examples/forms/schedule/schedule-controls-external-fiber.ts",
    "example:form:polling-accelerating": "tsx examples/forms/polling/polling-accelerating.ts",
    "example:form:schedule-delayed-start": "tsx examples/forms/polling/schedule-delayed-start.ts",
    "example:form:polling-spaced-read": "tsx examples/forms/polling/polling-spaced-read.ts",
    "example:form:polling-accelerating-reset-cadence": "tsx examples/forms/polling/polling-accelerating-reset-cadence.ts",
    "example:form:polling-accelerating-peek-cadence": "tsx examples/forms/polling/polling-accelerating-peek-cadence.ts",
    "prepare": "effect-language-service patch && effect-tsgo patch"
  },
