{
  "name": "@nikscripts/effect-pm",
  "version": "0.7.0-beta.0",
  "packageManager": "pnpm@10.33.4",
  "description": "Manage long-running Effect processes with runtime control. Queue resource-heavy operations with configurable throttling and priorities. Schedule recurring tasks with cron. Check status, start/stop processes, and view metrics through a CLI while your application runs.",
  "keywords": [
    "effect",
    "process-manager",
    "cron",
    "scheduler",
    "queue",
    "priority-queue",
    "task-scheduler",
    "job-queue",
    "orchestration",
    "typescript"
  ],
  "author": "Nikolas Stow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikscripts/effect-pm.git"
  },
  "bugs": {
    "url": "https://github.com/nikscripts/effect-pm/issues"
  },
  "homepage": "https://github.com/nikscripts/effect-pm#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "import": "./dist/prisma/index.mjs",
      "require": "./dist/prisma/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "effect-pm": "./dist/bin/effect-pm.js"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:nwsl": "node scripts/nwsl-local.mjs test",
    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern repos/**",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "example": "tsx examples/example.ts",
    "example:typed-process-group": "tsx examples/typed-process-group.ts",
    "example:queue-resource": "tsx examples/queue-resource.ts",
    "example:process-patterns": "tsx examples/process-supervisor-patterns.ts",
    "example:process-supervisor-patterns": "tsx examples/process-supervisor-patterns.ts",
    "example:sports-polling-accelerating": "tsx examples/sports-polling-accelerating.ts",
    "example:schedule-gates-and-cron": "tsx examples/schedule-control-surfaces.ts",
    "example:schedule-control-surfaces": "tsx examples/schedule-control-surfaces.ts",
    "example:schedule-control-basics": "tsx examples/schedule-control-basics.ts",
    "example:schedule-control-db-sync": "tsx examples/schedule-control-db-sync.ts",
    "example:process-game-window": "tsx examples/process-game-window-with-group.ts",
    "example:run-resource": "tsx examples/run-resource.ts",
    "example:http-client-run-gate": "tsx examples/http-client-run-gate.ts",
    "example:http-api-resource": "tsx examples/http-api-resource.ts",
    "example:nwsl-http-api-resource": "node scripts/nwsl-local.mjs example",
    "cli": "tsx examples/cli.ts",
    "example:http-api-resource-layer-effect": "tsx examples/http-api-resource-layer-effect.ts",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.65",
    "cli-table3": "^0.6.5",
    "pretty-ms": "^9.3.0"
  },
  "peerDependencies": {
    "@prisma/client": ">=5",
    "effect": "^4.0.0-beta.65"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "^0.85.1",
    "@effect/tsgo": "0.5.2",
    "@effect/vitest": "4.0.0-beta.65",
    "@types/node": "^20.19.40",
    "@typescript/native-preview": "7.0.0-dev.20260510.1",
    "effect": "^4.0.0-beta.65",
    "eslint": "^10.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
