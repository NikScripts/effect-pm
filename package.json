{
  "name": "@nikscripts/effect-pm",
  "version": "0.8.0-beta.28",
  "packageManager": "pnpm@10.33.4",
  "description": "Manage long-running Effect processes with runtime control. Queue resource-heavy operations with configurable throttling and priorities. Schedule recurring tasks with cron. Check status, start/stop processes, and view metrics through a CLI while your application runs.",
  "keywords": [
    "effect",
    "process-manager",
    "cron",
    "scheduler",
    "queue",
    "priority-queue",
    "task-scheduler",
    "job-queue",
    "orchestration",
    "typescript"
  ],
  "author": "Nikolas Stow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikscripts/effect-pm.git"
  },
  "bugs": {
    "url": "https://github.com/nikscripts/effect-pm/issues"
  },
  "homepage": "https://github.com/nikscripts/effect-pm#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Process": {
      "types": "./dist/Process.d.ts",
      "default": "./dist/Process.js"
    },
    "./QueueResource": {
      "types": "./dist/QueueResource.d.ts",
      "default": "./dist/QueueResource.js"
    },
    "./CustomQueueResource": {
      "types": "./dist/CustomQueueResource.d.ts",
      "default": "./dist/CustomQueueResource.js"
    },
    "./Resource": {
      "types": "./dist/Resource.d.ts",
      "default": "./dist/Resource.js"
    },
    "./MultiNode": {
      "types": "./dist/MultiNode.d.ts",
      "default": "./dist/MultiNode.js"
    },
    "./ProcessStore": {
      "types": "./dist/ProcessStore.d.ts",
      "default": "./dist/ProcessStore.js"
    },
    "./ProcessStorage": {
      "types": "./dist/ProcessStorage.d.ts",
      "default": "./dist/ProcessStorage.js"
    },
    "./store/RunResource": {
      "types": "./dist/store/RunResource.d.ts",
      "default": "./dist/store/RunResource.js"
    },
    "./store/QueueResource": {
      "types": "./dist/store/QueueResource.d.ts",
      "default": "./dist/store/QueueResource.js"
    },
    "./store/Log": {
      "types": "./dist/store/Log.d.ts",
      "default": "./dist/store/Log.js"
    },
    "./store/ProcessLifecycle": {
      "types": "./dist/store/ProcessLifecycle.d.ts",
      "default": "./dist/store/ProcessLifecycle.js"
    },
    "./store/ProcessExecution": {
      "types": "./dist/store/ProcessExecution.d.ts",
      "default": "./dist/store/ProcessExecution.js"
    },
    "./Query": {
      "types": "./dist/Query.d.ts",
      "default": "./dist/Query.js"
    },
    "./ResourceConfigure": {
      "types": "./dist/ResourceConfigure.d.ts",
      "default": "./dist/ResourceConfigure.js"
    },
    "./RuntimeStorage": {
      "types": "./dist/RuntimeStorage.d.ts",
      "default": "./dist/RuntimeStorage.js"
    },
    "./Logs": {
      "types": "./dist/Logs.d.ts",
      "default": "./dist/Logs.js"
    },
    "./NodeLogs": {
      "types": "./dist/NodeLogs.d.ts",
      "default": "./dist/NodeLogs.js"
    },
    "./NodeStatus": {
      "types": "./dist/NodeStatus.d.ts",
      "default": "./dist/NodeStatus.js"
    },
    "./HistoryStore": {
      "types": "./dist/HistoryStore.d.ts",
      "default": "./dist/HistoryStore.js"
    },
    "./DurableQueueStore": {
      "types": "./dist/DurableQueueStore.d.ts",
      "default": "./dist/DurableQueueStore.js"
    },
    "./Group": {
      "types": "./dist/Group.d.ts",
      "default": "./dist/Group.js"
    },
    "./Store": {
      "types": "./dist/Store.d.ts",
      "default": "./dist/Store.js"
    },
    "./ApiMetrics": {
      "types": "./dist/ApiMetrics.d.ts",
      "default": "./dist/ApiMetrics.js"
    },
    "./Telemetry": {
      "types": "./dist/Telemetry.d.ts",
      "default": "./dist/Telemetry.js"
    },
    "./ApiUsageSchema": {
      "types": "./dist/ApiUsageSchema.d.ts",
      "default": "./dist/ApiUsageSchema.js"
    },
