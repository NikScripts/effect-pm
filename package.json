    "effect": "4.0.0-beta.92",
    "eslint": "^10.3.0",
    "ink": "^7.1.0",
    "ink-testing-library": "^4.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.0",
    "react-devtools-core": "^7.0.1",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.11.2",
