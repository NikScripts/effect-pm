{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "react"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "../../test/view-jsx.test-d.tsx",
    "../../test/view-jsx-radix.test.tsx",
    "../../test/last-provide.test-d.ts",
    "../../test/last-provide.test.ts",
    "../../test/view-service.test-d.ts",
    "../../test/view-service-default.test-d.ts",
    "../../test/view-service-default.test.ts",
    "../../test/router-page-props.test-d.ts"
  ],
  "exclude": ["node_modules"]
}
