{
  "$schema": "https://opencode.ai/config.json",
  // "console" is the agent this package's client talks to (see src/opencode/client.ts).
  //
  // Phase 2: edit/write/patch now allowed — the agent can create and modify files.
  // bash/task stay denied — only editing was asked for; shell execution and subagent
  // delegation are a materially bigger blast radius and weren't part of that ask.
  "agent": {
    "console": {
      "mode": "primary",
      "description": "Phase 2 chat agent — read/search/LSP/edit; no shell, no subagent delegation.",
      // Hard cap on agentic loop iterations — a general safety margin, not a fix for anything
      // specific observed here. (A real runaway loop *was* hit and root-caused during this
      // client's own build: a client-supplied `messageID` in the prompt request broke the
      // server's turn-completion tracking, so the session never reached `session.idle`. The
      // actual fix was dropping the client-side ID entirely — see useSessionStream.ts's top
      // comment — not this setting. `steps` stays as a ceiling regardless.)
      "steps": 8,
      "permission": {
        // Explicit "deny" (not the default "ask") — this client has no permission-response
        // UI yet, and "ask" with no answerer is untested territory. `doom_loop` is opencode's
        // own protection against exactly the kind of runaway loop found and root-caused while
        // building this client (see the `steps` comment above) — keep it active, not disabled.
        "doom_loop": "deny",
        "edit": "allow",
        // "write" (new-file creation) isn't in opencode's documented/schema-named permission
        // keys, but PermissionObjectConfig accepts arbitrary keys via additionalProperties and
        // the runtime honors it (confirmed hands-on, see the phase-1 write/edit spike notes
        // in README.md — that spike is *why* both are listed explicitly here, not just "edit").
        "write": "allow",
        "patch": "allow",
        "bash": "deny",
        // Confirmed hands-on: without this, the console agent could invoke the `task` tool
        // to delegate to a general-purpose subagent — which has its OWN, unrestricted
        // permissions — and that subagent created a file `console`'s own edit/write/bash
        // denial never touched. Denying `task` closes that delegation path entirely.
        "task": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "webfetch": "allow"
      },
      // Belt-and-suspenders for the tools still denied above (deprecated field, but it gates
      // tool *registration*, not just the permission check — a second layer in case a future
      // tool ever bypasses the permission list the way "write" did in phase 1).
      "tools": {
        "bash": false,
        "task": false
      }
    }
    // "repo-admin" (worktree creation/scanning, see src/opencode/worktree.ts
    // and repoScan.ts) is NOT defined here — it has to run `git worktree`
    // commands against arbitrary repos elsewhere on disk, and opencode's
    // agent config is directory-scoped (an agent defined here is invisible
    // to a session whose directory isn't this project's tree — confirmed
    // hands-on: session.shell/session.prompt 500'd with an opaque
    // "UnknownError" instead of a clean "agent not found" when it couldn't
    // resolve repo-admin for the target repo's directory). It's defined
    // globally instead, in ~/.config/opencode/opencode.jsonc.
  }
}
